#!/usr/bin/env perl

my $brightness = `cat /sys/class/backlight/amdgpu_bl0/actual_brightness`;
my $max_brightness = `cat /sys/class/backlight/amdgpu_bl0/max_brightness`;

$brightness += 5;
$brightness = $max_brightness if $brightness > $max_brightness;

my $junk = `echo $brightness > /sys/class/backlight/amdgpu_bl0/brightness`;

